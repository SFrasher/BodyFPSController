[sub_resource type="GDScript" id="GDScript_ewwf0"]
script/source = "extends TwoBoneIK3D

@export var enable: bool = true
@export var min_physics_rate := 15
@export var max_physics_rate := 240
@export var sync_tolerance := 0.001

var _current_fps := 0.0
var _frame_times := []

func _ready():
	# Initialize with a reasonable default
	Engine.physics_ticks_per_second = min_physics_rate
	set_process(enable)

func _process(delta):
	if enable:
		# Track frame rate (smoothed average)
		_frame_times.push_back(delta)
		if _frame_times.size() > 10:
			_frame_times.pop_front()
		
		var avg_frame_time = _frame_times.reduce(func(a, b): return a + b) / _frame_times.size()
		_current_fps = 1.0 / avg_frame_time
		
		# Adjust physics rate dynamically
		var target_physics_rate = clamp(_current_fps, min_physics_rate, max_physics_rate)
		
		if abs(Engine.physics_ticks_per_second - target_physics_rate) > sync_tolerance:
			Engine.physics_ticks_per_second = int(target_physics_rate)
			
"

[sub_resource type="GDScript" id="GDScript_kcbsn"]
script/source = "extends CopyTransformModifier3D

@export var enable: bool = true
@export var min_physics_rate := 15
@export var max_physics_rate := 240
@export var sync_tolerance := 0.001

var _current_fps := 0.0
var _frame_times := []

func _ready():
	# Initialize with a reasonable default
	Engine.physics_ticks_per_second = min_physics_rate
	set_process(enable)

func _process(delta):
	if enable:
		# Track frame rate (smoothed average)
		_frame_times.push_back(delta)
		if _frame_times.size() > 10:
			_frame_times.pop_front()
		
		var avg_frame_time = _frame_times.reduce(func(a, b): return a + b) / _frame_times.size()
		_current_fps = 1.0 / avg_frame_time
		
		# Adjust physics rate dynamically
		var target_physics_rate = clamp(_current_fps, min_physics_rate, max_physics_rate)
		
		if abs(Engine.physics_ticks_per_second - target_physics_rate) > sync_tolerance:
			Engine.physics_ticks_per_second = int(target_physics_rate)
"

